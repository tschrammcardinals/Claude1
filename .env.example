KALSHI_API_KEY_ID=your-key-id-here
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi_private_key.pem
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_BASE=wss://api.elections.kalshi.com/trade-api/ws/v2

# Paper mode is the default. Set to "true" to allow live orders (still requires
# --live on the CLI as a second confirmation).
KALSHI_LIVE=false

# Optional: the-odds-api.com key for live sportsbook anchor.
# Free tier = 500 requests/month. The trader caches each /odds response for
# ODDS_API_CACHE_SECONDS, so a single fetch covers many matches. At 300s
# (default) you'll use roughly 12 requests/hour during active tennis play —
# fine for the free tier. Bump to 60 if you upgrade to a paid plan.
ODDS_API_KEY=
ODDS_API_CACHE_SECONDS=300

# Optional override for the model artifact directory.
ARTIFACTS_DIR=./artifacts
